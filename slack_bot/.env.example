# Slack: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack: Basic Information -> App-Level Tokens (scope: connections:write). Not needed for --once.
SLACK_APP_TOKEN=xapp-...
# Channel ID (right-click channel -> Copy link; the C... part). Invite the bot to it.
DIGEST_CHANNEL_ID=C0123456789

GCP_PROJECT=blitzscale-prod-project
# Path to a service-account key with BigQuery Job User + Data Viewer on nushop
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

DIGEST_HOUR_IST=9
DIGEST_MINUTE_IST=30
STUCK_AFTER_DAYS=7
STUCK_LIST_LIMIT=15
